---
import Layout from './layouts/layout.astro';
import { collections } from './layouts/collections.js';
import { itemsCollections } from './layouts/collections.js';

import TopBar from './components/top-bar.astro';
import Header from './components/header.astro';
import Nav from './components/nav.astro';
import Footer from './components/footer.astro';
import AppMenu from './components/app-menu.astro';
import TabBar from './components/tab-bar.astro';
import Preloader from './components/preloader.astro';

import Modal from './components/modal.astro';
import Cart from './components/cart.astro';

const inputPreloaderJs = import.meta.env.DEV
    ? '/src/js/preloader.js'
    : 'js/preloader.js';

const gsapJs = import.meta.env.DEV
    ? '/src/assets/files/js/libs/gsap/gsap.min.js'
    : 'js/libs/gsap/gsap.min.js';

const ScrollTriggerJs = import.meta.env.DEV
    ? '/src/assets/files/js/libs/gsap/ScrollTrigger.min.js'
    : 'js/libs/gsap/ScrollTrigger.min.js';

const animationJs = import.meta.env.DEV
    ? '/src/js/animation.js'
    : 'js/animation.js';

const title = 'Главная страница';
const reviewCount = 8;
