---
import Layout from './layouts/layout.astro';

import TopBar from './components/top-bar.astro';
import Header from './components/header.astro';
import Nav from './components/nav.astro';
import Footer from './components/footer.astro';
import AppMenu from './components/app-menu.astro';
import TabBar from './components/tab-bar.astro';
import {itemsCollections} from './layouts/collections.js';
import {categories} from './layouts/categories.js';
import PromoCode from "./components/promo-code.astro";
import FieldPhone from "./components/field-phone.astro";
import FormPolicy from "./components/form-policy.astro";
import OrderNav from "./components/order-nav.astro";

import Modal from './components/modal.astro';
import Cart from './components/cart.astro';

const iMaskJs = import.meta.env.DEV
    ? '/src/assets/files/js/libs/imask/imask.min.js'
    : 'js/libs/imask/imask.min.js';

const inputPhoneJs = import.meta.env.DEV
    ? '/src/js/inpuit-phone.js'
    : 'js/inpuit-phone.min.js';

const title = 'Оформление заказа';
---


<Layout title={title}>

    <Fragment slot="head">

    </Fragment>

    <main class="main">

        <TopBar/>

        <Header/>

        <Nav/>

        <AppMenu/>

        <div class="order-page">
            <div class="container">

                <ol class="breadcrumb breadcrumb--center">
                    <li class="breadcrumb__item">
                        <a href="#" class="breadcrumb__link">Главная</a>
                    </li>
                    <li class="breadcrumb__item">
                        <a href="#" class="breadcrumb__link">Корзина</a>
                    </li>
                    <li class="breadcrumb__item">
                        <span class="breadcrumb__active">{title}</span>
                    </li>
                </ol>

                <h1 class="order-header">{title}</h1>

                <OrderNav/>

                <div class="order">
                    <div class="order__aside">
                        <div class="order__title">Ваш заказ</div>
                        <div class="order__gift">
                            <a href="#" class="order-gift">
                                <div class="order-gift__icon">
                                    <svg class="icon" viewBox="0 0 16 16">
                                        <use href="img/sprites/sprite.svg#gift"></use>
                                    </svg>
                                </div>
                                <div class="order-gift__text">Добавьте в корзину еще 1 товар и получите подарок на выбор</div>
                                <div class="order-gift__arrow">
                                    <svg class="icon" viewBox="0 0 8 9">
                                        <use href="img/sprites/sprite.svg#btn_arrow"></use>
                                    </svg>
                                </div>
                            </a>
                        </div>
                        <div class="order__goods">
                            <div class="cart-item">
                                <a href="#" class="cart-item__media">
                                    <img src="img/content/order_image.png" class="img-cover" alt="" loading="lazy">
                                </a>
                                <div class="cart-item__main">
                                    <div class="cart-item__wrapper">
                                        <div class="cart-item__tags">
                                            <div class="cart-item__tags-row">
                                                <div class="item-tag item-tag--sm item-tag--black"><span>New</span></div>
                                                <div class="item-tag item-tag--sm item-tag--red"><span>-20%</span></div>
                                            </div>
                                            <div class="cart-item__brand">Annbeauty</div>
                                        </div>
                                        <div class="cart-item__buttons">
                                            <button type="button" class="cart-item__favorite" data-add-favorite>
                                                <svg class="icon" viewBox="0 0 22 22">
                                                    <use href="img/sprites/sprite.svg#heart_20"></use>
                                                </svg>
                                            </button>
                                            <button type="button" class="cart-item__remove" data-add-favorite>
                                                <svg class="icon" viewBox="0 0 22 22">
                                                    <use href="img/sprites/sprite.svg#trash"></use>
                                                </svg>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="cart-item__title">
                                        <a href="#">Маска-патчи для глаз 111SKIN Celestial Black Diamond Eye Mask</a>
                                    </div>
                                    <div class="cart-item__footer">
                                        <div class="cart-item__quantity">
                                            <div class="quantity" data-quantity>
                                                <button type="button" class="quantity__control" data-quantity-down>-
                                                </button>
                                                <div class="quantity__input">
                                                    <input type="number" class="quantity__value" value="1" min="0"
                                                           max="99" data-quantity-value disabled>
                                                </div>
                                                <button type="button" class="quantity__control" data-quantity-up>+
                                                </button>
                                            </div>
                                        </div>
                                        <div class="cart-item__prices">
                                            <div class="cart-item__price-old">579,99 BYN</div>
                                            <div class="cart-item__price">499,99</div>
                                        </div>
                                    </div>
                                </div>
                            </div><!-- .cart-item -->
                            <div class="cart-item">
                                <a href="#" class="cart-item__media">
                                    <img src="img/content/order_image.png" class="img-cover" alt="" loading="lazy">
                                </a>
                                <div class="cart-item__main">
                                    <div class="cart-item__wrapper">
                                        <div class="cart-item__tags">
                                            <div class="cart-item__tags-row">
                                                <div class="item-tag item-tag--sm item-tag--black"><span>New</span></div>
                                                <div class="item-tag item-tag--sm item-tag--red"><span>-20%</span></div>
                                            </div>
                                            <div class="cart-item__brand">Annbeauty</div>
                                        </div>
                                        <div class="cart-item__buttons">
                                            <button type="button" class="cart-item__favorite" data-add-favorite>
                                                <svg class="img-cover" viewBox="0 0 22 22">
                                                    <use href="img/sprites/sprite.svg#heart_20"></use>
                                                </svg>
                                            </button>
                                            <button type="button" class="cart-item__remove" data-add-favorite>
                                                <svg class="img-cover" viewBox="0 0 22 22">
                                                    <use href="img/sprites/sprite.svg#trash"></use>
                                                </svg>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="cart-item__title">
                                        <a href="#">Маска-патчи для глаз 111SKIN Celestial Black Diamond Eye Mask</a>
                                    </div>
                                    <div class="cart-item__footer">
                                        <div class="cart-item__quantity">
                                            <div class="quantity" data-quantity>
                                                <button type="button" class="quantity__control" data-quantity-down>-
                                                </button>
                                                <div class="quantity__input">
                                                    <input type="number" class="quantity__value" value="1" min="0"
                                                           max="99" data-quantity-value disabled>
                                                </div>
                                                <button type="button" class="quantity__control" data-quantity-up>+
                                                </button>
                                            </div>
                                        </div>
                                        <div class="cart-item__prices">
                                            <div class="cart-item__price-old">579,99 BYN</div>
                                            <div class="cart-item__price">499,99</div>
                                        </div>
                                    </div>
                                </div>
                            </div><!-- .cart-item -->
                        </div>
                        <div class="order__promo">
                            <PromoCode/>
                        </div>

                        <div class="order__delivery">
                            <div class="free-delivery">
                                <div class="free-delivery__main">
                                    <div class="free-delivery__lead">
                                        <div class="free-delivery__label">Для бесплатной доставки добавьте товаров еще
                                            на:
                                        </div>
                                        <div class="free-delivery__value">99,99 BYN</div>
                                    </div>
                                    <div class="free-delivery__text">Предложение распространяется на доставку в
                                        отделение «Европочта».
                                    </div>
                                </div>
                                <div class="free-delivery__scale">
                                    <div class="free-delivery__progress" style="width: 65%"></div>
                                </div>
                            </div>
                        </div>

                        <div class="order__clearing">
                            <div class="clearing">
                                <button type="button" class="clearing__button">
                                    <i>
                                        <svg class="img-cover" viewBox="0 0 6 6">
                                            <use href="img/sprites/sprite.svg#clearing"></use>
                                        </svg>
                                    </i>
                                    <span>Очистить корзину</span>
                                </button>
                            </div>
                        </div>

                        <div class="order__result">
                            <div class="result-item">
                                <div class="result-item__title">Скидка:</div>
                                <div class="result-item__value">49,50 BYN</div>
                            </div>
                            <div class="result-item">
                                <div class="result-item__title">Персональная скидка: <strong>5%</strong></div>
                                <div class="result-item__value">20,00 BYN</div>
                            </div>
                            <div class="result-item">
                                <div class="result-item__title">Сумма заказа:</div>
                                <div class="result-item__value result-item__value--total">499,99 BYN</div>
                            </div>
                        </div>

                        <div class="order-submit">
                            <div class="order-submit__main">
                                <div class="order-submit__label">Сумма заказа:</div>
                                <div class="order-submit__price">499,99 BYN</div>
                            </div>
                            <div class="order-submit__button">
                                <button type="button" class="btn btn-primary">
                                    <span>Оформить</span>
                                    <i>
                                        <svg class="icon" viewBox="0 0 8 9">
                                            <use href="img/sprites/sprite.svg#btn_arrow"></use>
                                        </svg>
                                    </i>
                                </button>
                            </div>
                        </div>

                    </div>
                    <div class="order__main">
                        <div class="order__group">
                            <div class="order__title">Куда и как доставить?</div>
                            <div class="order__list">
                                <div class="order__item">
                                    <div class="delivery-item">
                                        <div class="delivery-item__control">
                                            <label class="checkbox">
                                                <input type="radio" name="delivery" class="checkbox__input" value="1"
                                                       checked>
                                                <i class="checkbox__item"></i>
                                                <span class="checkbox__label">Самовывоз</span>
                                            </label>
                                        </div>
                                        <div class="delivery-item__price">Стоимость: <strong>0 BYN</strong></div>
                                    </div>
                                    <div class="delivery-field">
                                        <input type="text" class="field" name="delivery-input"
                                               value="г. Минск, ул. Тимирязева д. 126, пом. 85">
                                    </div>
                                </div>
                                <div class="order__item">
                                    <div class="delivery-item delivery-item--ship">
                                        <div class="delivery-item__control">
                                            <label class="checkbox">
                                                <input type="radio" name="delivery" class="checkbox__input" value="1">
                                                <i class="checkbox__item"></i>
                                                <span class="checkbox__label">Европочта (Пункты выдачи Европочта)</span>
                                            </label>
                                        </div>
                                        <div class="delivery-item__price">Стоимость: <strong>6 BYN</strong></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="order__group">
                            <div class="order__title">Выберите способ оплаты?</div>
                            <div class="order__list">
                                <div class="order__item">
                                    <label class="checkbox">
                                        <input type="radio" name="payment" class="checkbox__input" value="1" checked>
                                        <i class="checkbox__item"></i>
                                        <span class="checkbox__label">Оплата в магазине при получении</span>
                                    </label>
                                </div>
                                <div class="order__item">
                                    <label class="checkbox">
                                        <input type="radio" name="payment" class="checkbox__input" value="2">
                                        <i class="checkbox__item"></i>
                                        <span class="checkbox__label">Онлайн-оплата</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="order__group">
                            <div class="order__title">Личные данные</div>
                            <div class="order__form">
                                <div class="order__form-item">
                                    <input type="text" name="name" class="field field--md" placeholder="Введите вашу фамилию">
                                </div>
                                <div class="order__form-item">
                                    <input type="text" name="name" class="field field--md" placeholder="Введите ваше имя">
                                </div>
                                <div class="order__form-item">
                                    <input type="text" name="name" class="field field--md" placeholder="Введите ваше отчество">
                                </div>
                                <div class="order__form-item">
                                    <input type="text" name="name" class="field field--md"
                                           placeholder="Введите свою электронную почту">
                                </div>
                                <div class="order__form-item">
                                    <FieldPhone/>
                                </div>
                                <div class="order__form-policy">
                                    <FormPolicy/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div><!-- .order -->

                <div class="order-collection" data-collections>
                    <div class="section-header">
                        <div class="section-header__main">
                            <div class="section-header__wrap">
                                <h2 class="section-header__title title">Посмотрите также эти товары</h2>
                                <div class="section-header__text">Подобрано специально для вас</div>
                            </div>
                        </div>
                        <div class="section-header__control">
                            <button type="button" class="btn-control" data-collections-prev>
                                <i>
                                    <svg class="img-cover" viewBox="0 0 13 19">
                                        <use href="img/sprites/sprite.svg#nav_prev"></use>
                                    </svg>
                                </i>
                            </button>
                            <button type="button" class="btn-control" data-collections-next>
                                <i>
                                    <svg class="img-cover" viewBox="0 0 13 19">
                                        <use href="img/sprites/sprite.svg#nav_next"></use>
                                    </svg>
                                </i>
                            </button>
                        </div>
                    </div>
                    <div class="compilation-slider">
                        <div class="swiper" data-collections-slider>
                            <div class="swiper-wrapper">
                                {itemsCollections.map((item) => (
                                        <div class="swiper-slide">
                                            <div class="item">
                                                <div class="item__media">
                                                    <a href={item.link} class="item__image">
                                                        <img src={item.image} class="img-cover" width="576" height="560"
                                                             loading="lazy">
                                                    </a>

                                                    {item.tags.length > 0 && (
                                                            <div class="item__tags">
                                                                {item.tags.map((tag) => (
                                                                        <div class={`item-tag ${tag.class}`}>
                                                                            <span>{tag.text}</span>
                                                                        </div>
                                                                ))}
                                                            </div>
                                                    )}

                                                    <div class="item__button">
                                                        <button type="button" class="btn btn-md btn-primary">
                                                            <span>Купить</span>
                                                            <i>
                                                                <svg class="icon" viewBox="0 0 8 9">
                                                                    <use href="img/sprites/sprite.svg#btn_arrow"></use>
                                                                </svg>
                                                            </i>
                                                        </button>
                                                    </div>

                                                    <button type="button" class="item__favorite" data-add-favorite>
                                                        <i>
                                                            <svg class="img-cover" viewBox="0 0 16 15">
                                                                <use href="img/sprites/sprite.svg#heart"></use>
                                                            </svg>
                                                        </i>
                                                    </button>
                                                </div>

                                                <div class="item__content">
                                                    <div class="item__brand">{item.brand}</div>

                                                    <div class="item__title">
                                                        <a href={item.link}>{item.title}</a>
                                                    </div>

                                                    <div class="item__prices">
                                                        <div class="item__price-old">{item.priceOld}</div>
                                                        <div class="item__price">{item.price}</div>
                                                    </div>
                                                </div>
                                            </div><!-- .item -->
                                        </div>
                                ))}
                            </div>
                        </div>
                    </div>
                </div><!-- .section -->

                <div class="order-cat">
                    <div class="product-cat__header">
                        <h2 class="section-header__title title">Посмотрите ещё</h2>
                        <div class="product-cat__button">
                            <a href="#" class="btn btn-small btn-gray">
                                <span>Каталог товаров</span>
                            </a>
                        </div>
                    </div>
                    <div class="product-cat__main">
                        <div class="categories">
                            <div class="swiper" data-categories>
                                <div class="swiper-wrapper">
                                    <div class="swiper-slide">
                                        <div class="category-active">
                                            <span>Волосы</span>
                                        </div>
                                    </div>
                                    {categories.map((category, index) => (
                                            <div class="swiper-slide">
                                                <button type="button"
                                                        class:list={['category-item', {'is-active': index === 0}]}
                                                        data-category-item>
                                                    <i>
                                                        <img src={category.image} class="img-cover" alt="">
                                                    </i>
                                                    <span>{category.title}</span>
                                                </button>
                                            </div>
                                    ))}
                                </div>
                            </div>
                        </div>
                    </div>
                </div><!-- .section-categories -->
            </div>

        </div>

        <Footer/>

        <TabBar/>

        <Cart />

        <Modal />

    </main>

    <Fragment slot="scripts">
        <script is:inline src={iMaskJs}></script>
        <script is:inline src={inputPhoneJs}></script>
    </Fragment>

</Layout>
