                                </div>
                                <div class="product-delivery__item">
                                    <div class="product-delivery__label">Курьер</div>
                                    <div class="product-delivery__value">в течении 3-х часов</div>
                                </div>
                                <div class="product-delivery__item">
                                    <div class="product-delivery__label">Европочта</div>
                                    <div class="product-delivery__value">16 августа</div>
                                </div>
                            </div>
