<div class="phone-field" data-phone>
    <div class="phone-code" data-phone-code>
        <div class="phone-code__control" data-phone-control>
            <div class="phone-code__media" data-phone-active>
                <div class="phone-code__flag">
                    <img src="img/flag/flag_bel.svg" class="img-cover">
                </div>
            </div>
            <div class="phone-code__arrow">
                <svg class="icon" viewBox="0 0 9 8">
                    <use href="img/sprites/sprite.svg#btn_arrow_down"></use>
                </svg>
            </div>
        </div>
        <div class="phone-code__content">
            <div class="phone-code__wrapper">
                <div class="phone-code__item" data-phone-item="+375 (__) ___-__-__">
                    <div class="phone-code__flag">
                        <img src="img/flag/flag_bel.svg" class="img-cover">
                    </div>
                    <div class="phone-code__label">BLR</div>
                </div>
                <div class="phone-code__item" data-phone-item="+7 (___) ___-__-__">
                    <div class="phone-code__flag">
                        <img src="img/flag/flag_ru.svg" class="img-cover">
                    </div>
                    <div class="phone-code__label">RUS</div>
                </div>
            </div>
        </div>
    </div>
    <input type="text" name="phone" class="field field--md" placeholder="+375 (__) ___-__-__" data-phone-input>
</div>
