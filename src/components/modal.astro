<div class="side" data-side="write_to_expert">
    <div class="side__header">
        <div class="side__title">Написать эксперту</div>
        <button type="button" class="btn-close" data-side-close>
            <svg class="icon" viewBox="0 0 17 17">
                <use href="img/sprites/sprite.svg#close"></use>
            </svg>
        </button>
    </div>
    <div class="side__subtitle">Оставьте контакты и наш эксперт ответит в течение 60 минут.</div>
    <div class="side__body">
        <form>
            <div class="form-item">
                <input type="text" class="field" name="name" placeholder="Введите ваше имя * ">
            </div>

            <div class="form-item">
                <input type="text" class="field" name="phone" placeholder="+375 (__) ___-__-__">
            </div>

            <div class="form-item">
                <textarea class="field" rows="3" name="text" placeholder="Коротко опишите вопрос"></textarea>
            </div>
            <div class="form-divider"></div>
            <div class="form-send">
                <button type="button" class="btn btn-primary w-100">
                    <span>Отправить анкету</span>
                    <i>
                        <svg class="ico-svg" viewBox="0 0 8 9">
                            <use href="img/sprites/sprite.svg#btn_arrow"></use>
                        </svg>
                    </i>
                </button>
            </div>
            <div class="form-policy">
                <label class="checkbox checkbox--md">
                    <input type="checkbox" class="checkbox__input" name="policy" value="1" checked>
                    <i class="checkbox__item"></i>
                    <span class="checkbox__label">Нажимая на кнопку «Оставить отзыв» , я соглашаюсь с условиями <a
                            href="#">публичной оферты</a> и <a href="#">политики конфиденциальности</a></span>
                </label>
            </div>
        </form>
    </div>

</div>

